# Normalize line endings across platforms (industry standard):
# LF in the repo for everything, CRLF only for Windows batch files.
* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.gz binary
*.zip binary
