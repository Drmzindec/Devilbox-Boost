# vim: set ft=yaml:
---
services:

  # -----------------------------------------------------------------------------------------------
  # RustFS - S3-compatible object storage (MinIO replacement)
  # -----------------------------------------------------------------------------------------------
  rustfs:
    image: rustfs/rustfs:${RUSTFS_SERVER:-latest}
    hostname: rustfs
    environment:
      - RUSTFS_VOLUMES=/data
      - RUSTFS_ADDRESS=0.0.0.0:9000
      - RUSTFS_CONSOLE_ENABLE=true
      - RUSTFS_CONSOLE_ADDRESS=0.0.0.0:9001
      - RUSTFS_ACCESS_KEY=${RUSTFS_ACCESS_KEY:-rustfsadmin}
      - RUSTFS_SECRET_KEY=${RUSTFS_SECRET_KEY:-rustfsadmin}
    ports:
      - "${LOCAL_LISTEN_ADDR}${HOST_PORT_RUSTFS:-9000}:9000"
      - "${LOCAL_LISTEN_ADDR}${HOST_PORT_RUSTFS_CONSOLE:-9001}:9001"
    networks:
      app_net:
        ipv4_address: 172.16.238.204
    volumes:
      - devilbox-rustfs:/data
    depends_on:
      - bind
      - php
      - httpd
    healthcheck:
      test: ["CMD-SHELL", "curl -sf http://localhost:9000/health || curl -sf http://localhost:9000/ || exit 1"]
      interval: 30s
      timeout: 20s
      retries: 3
      start_period: 15s

volumes:
  devilbox-rustfs:
